# ========================================================
# CONFIGURAÇÕES DO SERVIDOR
# ========================================================
PORT=3001
NODE_ENV=development

# ========================================================
# BANCO DE DADOS (PostgreSQL do e-SUS APS PEC)
# ========================================================
# Endereço ou IP da máquina onde o e-SUS PEC está instalado
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nome_db
DB_USER=postgres
DB_PASSWORD=postgres

DB_SSL=false

# ========================================================
# FILTRO DE UNIDADES BÁSICAS DE SAÚDE (UBS)
# ========================================================
# Se vazio, todas as unidades ativas da tabela tb_unidade_saude serão disponibilizadas.
# Caso queira restringir a unidades específicas, informe os IDs separados por vírgula:
# Exemplo: UNIDADES_IDS=6,4,23,17,8,21,7,9,18,20,5
UNIDADES_IDS=

# ========================================================
# SEGURANÇA E LIMITADORES
# ========================================================
# Origens permitidas no CORS (separadas por virgula)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Limite de requisicoes por IP
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MINUTES=15
